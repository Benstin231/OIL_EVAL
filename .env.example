# Gemini API key — used by orchestrator.py's "gemma" provider (gemma/<model> role strings)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# orchestrator.py provider registry (OpenAI-compatible endpoints)
# ---------------------------------------------------------------------------
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

QWEN_BASE_URL=your_dashscope_compatible_mode_url_here
QWEN_API_KEY=your_qwen_api_key_here

MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=your_mimo_api_key_here

# STRATEGY=single | analyze-then-code | debate
STRATEGY=single
SINGLE_MODEL=deepseek/deepseek-v4-flash
ARCHITECT_MODEL=deepseek/deepseek-v4-flash
CODER_MODEL=qwen/qwen3.7-plus
DEBATER1_MODEL=deepseek/deepseek-v4-flash
DEBATER2_MODEL=qwen/qwen3.7-plus
JUDGE_MODEL=mimo/mimo-v2.5
